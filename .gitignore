# farm runtime dirs (these live on the shared volume, never in git)
queue/
running/
done/
failed/
assets/
models/
loras/
logs/

# per-Mac limit overrides live on the share, never in git
farm.conf.*

# tauri / node / rust build output
desktop/node_modules/
desktop/dist/
desktop/src-tauri/target/
desktop/src-tauri/gen/
# the frontend: source is tracked, deps and the build are not. dist/ is embedded
# into the binary at compile time (build.rs), so it's a build artifact like target/.
desktop/ui-react/node_modules/
desktop/ui-react/dist/

# macOS
.DS_Store

# generated by the UI test run
desktop/test/shots/
